# Required for live LLM replies (Mastra still boots without it)
OPENAI_API_KEY=

# Must match server/.env AGENT_API_KEY (required for tool calls)
AGENT_API_KEY=lynk-dev-agent-key-16

LYNK_API_URL=http://127.0.0.1:43124
CLIENT_ORIGIN=http://127.0.0.1:43123

# Bind address for the Mastra runtime. Defaults to loopback.
# AGENT_HOST=127.0.0.1

# Per signed-in user cap on CopilotKit turns.
# AGENT_TURN_LIMIT=30
# AGENT_TURN_WINDOW_MS=600000
