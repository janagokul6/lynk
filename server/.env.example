NODE_ENV=development
PORT=43124
DATABASE_URL=postgresql://lynk:lynk@127.0.0.1:5432/lynk
BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long
BETTER_AUTH_URL=http://127.0.0.1:43124
CLIENT_ORIGIN=http://127.0.0.1:43123

# Shared with packages/agent/.env — required for Mastra → Lynk tools.
# Development may use the example value. Production refuses this value and any key shorter than 32 characters.
AGENT_API_KEY=lynk-dev-agent-key-16

# Per signed-in user cap for POST /api/tools (agent turns and tool calls share this budget).
AGENT_TURN_LIMIT=30
AGENT_TURN_WINDOW_MS=600000

# Trusted reverse-proxy hops used to read the client IP for rate limits.
# 0 (default) ignores X-Forwarded-For. Set to 1 behind a single load balancer.
TRUST_PROXY=0

# Max pgvector cosine distance (<=>) for creator search. 0 is identical.
# 0.75 keeps niche overlap (for example "beauty skincare") and drops unrelated queries.
MATCH_MAX_DISTANCE=0.75

# Google login (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Discovery / Connect (optional)
# YOUTUBE_API_KEY=
# META_GRAPH_API_VERSION=v25.0
# META_IG_USER_ID=
# META_PAGE_ACCESS_TOKEN=

# Cloudflare R2 (optional; local disk fallback otherwise)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# 32-byte key used to encrypt social tokens at rest. Required in production.
# Generate with: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=

# Browser-supplied access/refresh tokens on POST /api/connections.
# Leave false until the OAuth connect flow exists. When true, TOKEN_ENCRYPTION_KEY is required.
# ALLOW_CLIENT_SOCIAL_TOKENS=false

# Mail. Use Resend, SMTP, or neither. Unset transports log the message.
# RESEND_API_KEY=
# SMTP_URL=smtp://user:pass@localhost:587
# MAIL_FROM=Lynk <noreply@example.com>

# Embeddings. Unset keeps the local hash fallback.
# OPENAI_API_KEY=

# Instagram Login for creator connect. Separate from the discovery page token.
# META_APP_ID=
# META_APP_SECRET=

# Error tracking. Unset is a no-op.
# SENTRY_DSN=
