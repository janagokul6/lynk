# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lynk?schema=public"

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# YouTube (optional, for discovery search suggestions)
# YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# Instagram Creator Marketplace (optional, for discovery search suggestions)
# META_GRAPH_API_VERSION=v25.0
# META_IG_USER_ID=17841400000000000
# META_PAGE_ACCESS_TOKEN=your-page-access-token

# Rate Limiting (optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# RATE_LIMIT_AUTH_MAX=5
