NODE_ENV=development
PORT=43124
DATABASE_URL=postgresql://lynk:lynk@localhost:5432/lynk
BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long
BETTER_AUTH_URL=http://localhost:43124
CLIENT_ORIGIN=http://localhost:43123

# Optional agent tool auth (x-agent-key)
# AGENT_API_KEY=

# Google login (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Discovery / Connect (optional)
# YOUTUBE_API_KEY=
# META_GRAPH_API_VERSION=v25.0
# META_IG_USER_ID=
# META_PAGE_ACCESS_TOKEN=

# Cloudflare R2 (optional; local disk fallback otherwise)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# 32-byte key used to encrypt social tokens at rest. Required in production.
# Generate with: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=

# Browser-supplied access/refresh tokens on POST /api/connections.
# Leave false until the OAuth connect flow exists. When true, TOKEN_ENCRYPTION_KEY is required.
# ALLOW_CLIENT_SOCIAL_TOKENS=false
