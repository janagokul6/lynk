NODE_ENV=development
PORT=43124
DATABASE_URL=postgresql://lynk:lynk@127.0.0.1:5432/lynk
BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long
BETTER_AUTH_URL=http://127.0.0.1:43124
CLIENT_ORIGIN=http://127.0.0.1:43123

# Shared with packages/agent/.env — required for Mastra → Lynk tools
AGENT_API_KEY=lynk-dev-agent-key-16

# Google login (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Discovery / Connect (optional)
# YOUTUBE_API_KEY=
# META_GRAPH_API_VERSION=v25.0
# META_IG_USER_ID=
# META_PAGE_ACCESS_TOKEN=

# Cloudflare R2 (optional; local disk fallback otherwise)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
