{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": [
    "config/**/*",
    "db/**/*",
    "lib/**/*",
    "middleware/**/*",
    "modules/**/*",
    "policies/**/*",
    "utils/**/*",
    "app.ts",
    "server.ts",
    "workers/**/*",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "drizzle",
    "**/*.test.ts"
  ]
}
